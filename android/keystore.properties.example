# Copy this file to android/keystore.properties (NOT committed — see .gitignore)
# and fill in the real values after generating your release keystore.
#
# storeFile is resolved relative to android/ (the Gradle root project),
# so either keep the .jks/.keystore file directly inside android/ and use
# just its filename, or use an absolute path if you'd rather store it
# somewhere outside the repo entirely (recommended).

storeFile=/absolute/path/to/lilium-release.keystore
storePassword=CHANGE_ME
keyAlias=lilium
keyPassword=CHANGE_ME
